[Public]
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutCuidenAFer,Description="[Irreal] Cuiden a Fer!||Cada oleada de Invasión un jugador al azar (humano o bot) es Fer: no puede disparar ni levantar armas, munición o adrenalina, y todos los monstruos lo persiguen. Si Fer muere, termina la partida. Entre oleadas hay 90 segundos de descanso con +50% de velocidad. Solo compatible con [Irreal] Necesitamos más BOTS, [Irreal] Chat-doka Bots, [Irreal] Invasión: Armas últimas, [Irreal] Sigan viendo y Salto cuádruple (QuadJump). Bloquea partidas con otros mutadores.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionPause,Description="[Irreal] Control de plagas FV||Pausa el inicio de la siguiente oleada en Invasión y otorga +50% de velocidad durante la pausa para recolectar ítems. El host o un admin inicia la oleada con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInstantRespawn,Description="[Irreal] Es todo muy irreal||Elimina el cooldown de los ítems del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a ítems que los jugadores dejaron caer.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutMarianoskyRage,Description="[Irreal] Marianosky's rage||25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamaño, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos daño, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y más cohetes. Al morir da doble puntaje, suelta un Double Damage, otorga +25 de escudo al equipo y revive a un compañero caído.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutChatDokaBots,Description="[Irreal] Chat-doka Bots||Hace que los bots escriban frases personalizadas y contextuales en el chat (una frase al azar cada 30 segundos, reacción al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutNeedMoreBots,Description="[Irreal] Necesitamos más BOTS||Ajusta dinámicamente la cantidad de bots a una escala de 3 bots por cada jugador real conectado en la partida (máximo 24 bots).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionUltimates,Description="[Irreal] Invasión: Armas últimas||Un único punto de arma alterna al azar entre Redeemer, Ion Painter y Lightning Gun en cada ronda, con respawn instantáneo. Los demás puntos de esas armas quedan vacíos.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutSixSeven,Description="[Irreal] Six Seven||En batallas por equipos (excepto Invasión), ubica siempre a todos los jugadores reales en el Equipo Azul y a todos los bots en el Equipo Rojo. Desactiva el balanceo automático de equipos.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutKayros,Description="[Irreal] ¿Poco o mucho Kayros?||En cada ronda elige a 1 jugador humano al azar y le otorga Mucho Kayros (+20% en todos los pickups) o Poco Kayros (-20% en todos los pickups).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutLeTransmitoTodoAMiBB,Description="[Irreal] Le transmito todo a mi BB||Desde la oleada 9, cada oleada tiene 30% de probabilidad de que aparezca un Elite Krall cuyo rayo no hace daño pero infecta (-1 HP por segundo). La infección se contagia por cercanía y se cura apuntando 10 segundos seguidos con el disparo secundario de la Entrelazadora. Las infecciones se curan al terminar cada oleada.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutRadarMejorado,Description="[Irreal] Sigan viendo||Reemplaza los puntos del radar de Invasión por puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; el Rey Cthulhu aparece como un punto rojo más grande y Fer (en Cuiden a Fer!) en magenta. Los bots quedan con el punto tenue del radar original, para no llenar el radar. Además, cada monstruo o jugador que está en otro piso muestra una línea vertical: si está arriba, el punto queda sobre la línea; si está abajo, el punto cuelga de la línea. Cuanto más larga la línea, más diferencia de altura. Cada parte se puede desactivar en Configurar mutadores.")

[MutInvasionPause]
FriendlyName="[Irreal] Control de plagas FV"
Description="Pausa el inicio de la siguiente oleada en Invasión y otorga +50% de velocidad durante la pausa para recolectar ítems. El host o un admin inicia la oleada con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave)."

[MutInstantRespawn]
FriendlyName="[Irreal] Es todo muy irreal"
Description="Elimina el cooldown de los ítems del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a ítems que los jugadores dejaron caer."

[MutMarianoskyRage]
FriendlyName="[Irreal] Marianosky's rage"
Description="25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamaño, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos daño, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y más cohetes. Al morir da doble puntaje, suelta un Double Damage, otorga +25 de escudo al equipo y revive a un compañero caído."

[MutChatDokaBots]
FriendlyName="[Irreal] Chat-doka Bots"
Description="Hace que los bots escriban frases personalizadas y contextuales en el chat (una frase al azar cada 30 segundos, reacción al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano)."

[MutNeedMoreBots]
FriendlyName="[Irreal] Necesitamos más BOTS"
Description="Ajusta dinámicamente la cantidad de bots a una escala de 3 bots por cada jugador real conectado en la partida (máximo 24 bots)."

[MutSixSeven]
FriendlyName="[Irreal] Six Seven"
Description="En batallas por equipos (excepto Invasión), ubica siempre a todos los jugadores reales en el Equipo Azul y a todos los bots en el Equipo Rojo. Desactiva el balanceo automático de equipos."

[MutInvasionUltimates]
FriendlyName="[Irreal] Invasión: Armas últimas"
Description="Un único punto de arma alterna al azar entre Redeemer, Ion Painter y Lightning Gun en cada ronda, con respawn instantáneo. Los demás puntos de esas armas quedan vacíos."

[MutKayros]
FriendlyName="[Irreal] ¿Poco o mucho Kayros?"
Description="En cada ronda elige a 1 jugador humano al azar y le otorga Mucho Kayros (+20% en todos los pickups) o Poco Kayros (-20% en todos los pickups)."

[MutLeTransmitoTodoAMiBB]
FriendlyName="[Irreal] Le transmito todo a mi BB"
Description="Desde la oleada 9, cada oleada tiene 30% de probabilidad de que aparezca un Elite Krall cuyo rayo no hace daño pero infecta (-1 HP por segundo). La infección se contagia por cercanía y se cura apuntando 10 segundos seguidos con el disparo secundario de la Entrelazadora. Las infecciones se curan al terminar cada oleada."

[MutCuidenAFer]
FriendlyName="[Irreal] Cuiden a Fer!"
Description="Cada oleada de Invasión un jugador al azar (humano o bot) es Fer: no puede disparar ni levantar armas, munición o adrenalina, y todos los monstruos lo persiguen. Si Fer muere, termina la partida. Entre oleadas hay 90 segundos de descanso con +50% de velocidad. Solo compatible con [Irreal] Necesitamos más BOTS, [Irreal] Chat-doka Bots, [Irreal] Invasión: Armas últimas, [Irreal] Sigan viendo y Salto cuádruple (QuadJump). Bloquea partidas con otros mutadores."

[MutRadarMejorado]
FriendlyName="[Irreal] Sigan viendo"
ColoredDotsText="Puntos de colores"
ColoredDotsDesc="Puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; los bots quedan tenues, el Rey Cthulhu aparece en rojo y Fer en magenta. Si se desactiva, se ven los puntos normales del radar."
ShowHeightLinesText="Líneas de altura"
ShowHeightLinesDesc="Muestra una línea vertical en cada monstruo o jugador que está en otro piso."
MinHeightDiffText="Diferencia mínima de altura"
MinHeightDiffDesc="Diferencia de altura (en unidades, pies contra pies) a partir de la cual se dibuja la línea. Un piso suele estar a entre 200 y 500 unidades. Más bajo: más sensible."
Description="Reemplaza los puntos del radar de Invasión por puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; el Rey Cthulhu aparece como un punto rojo más grande y Fer (en Cuiden a Fer!) en magenta. Los bots quedan con el punto tenue del radar original, para no llenar el radar. Además, cada monstruo o jugador que está en otro piso muestra una línea vertical: si está arriba, el punto queda sobre la línea; si está abajo, el punto cuelga de la línea. Cuanto más larga la línea, más diferencia de altura. Cada parte se puede desactivar en Configurar mutadores."
