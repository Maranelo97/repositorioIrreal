[Public]
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutCuidenAFer,Description="Cuiden a Fer!||Cada oleada de Invasion un jugador al azar (humano o bot) es Fer: no puede disparar ni levantar armas, municion o adrenalina, y todos los monstruos lo persiguen. Si Fer muere, termina la partida. Entre oleadas hay 90 segundos de descanso con +50% de velocidad. Solo compatible con Necesitamos mas BOTS, Chat-doka BOTS, Invasion: Armas ultimas y Salto cuadruple. Bloquea partidas con otros mutadores.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionPause,Description="Control de plagas FV||Pausa el inicio de la siguiente ola en Invasion y otorga +50% de velocidad durante la pausa para recolectar items. El host o un admin inicia la ola con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInstantRespawn,Description="Es todo muy irreal||Elimina el cooldown de los items del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a items que los jugadores dejaron caer.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutMarianoskyRage,Description="Marianosky's rage||25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamano, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos dano, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y mas cohetes. Al morir da doble puntaje, suelta un Double Damage, otorga +25 de escudo al equipo y revive a un companero caido.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutChatDokaBots,Description="Chat-doka Bots||Hace que los bots escriban frases personalizadas y contextuales en el chat (una frase al azar cada 30 segundos, reaccion al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutNeedMoreBots,Description="Necesitamos mas BOTS||Ajusta dinamicamente la cantidad de bots a una escala de 3 bots por cada jugador real conectado en la partida (maximo 24 bots).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionUltimates,Description="Invasion: Armas ultimas||Un unico punto de arma alterna al azar entre Redeemer, Target Painter, Ion Painter y Lightning Gun en cada ronda, con respawn instantaneo. Los demas puntos de esas armas quedan vacios.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutSixSeven,Description="Six Seven||En batallas por equipos (excepto Invasion), ubica siempre a todos los jugadores reales en el Equipo Azul y a todos los bots en el Equipo Rojo. Desactiva el balanceo automatico de equipos.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutKayros,Description="Poco o mucho Kayros?||En cada ronda elige a 1 jugador humano al azar y le otorga Mucho Kayros (+20% en todos los pickups) o Poco Kayros (-20% en todos los pickups).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutLeTransmitoTodoAMiBB,Description="Le transmito todo a mi BB||Desde la oleada 9, cada oleada tiene 30% de probabilidad de que aparezca un Elite Krall cuyo rayo no hace dano pero infecta (-1 HP por segundo). La infeccion se contagia por cercania y se cura apuntando 10 segundos seguidos con el disparo secundario de la Entrelazadora. Las infecciones se curan al empezar cada oleada.")

[MutInvasionPause]
FriendlyName="Control de plagas FV"
Description="Pausa el inicio de la siguiente ola en Invasion y otorga +50% de velocidad durante la pausa para recolectar items. El host o un admin inicia la ola con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave)."

[MutInstantRespawn]
FriendlyName="Es todo muy irreal"
Description="Elimina el cooldown de los items del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a items que los jugadores dejaron caer."

[MutMarianoskyRage]
FriendlyName="Marianosky's rage"
Description="25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamano, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos dano, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y mas cohetes. Al morir da doble puntaje, suelta un Double Damage, otorga +25 de escudo al equipo y revive a un companero caido."

[MutChatDokaBots]
FriendlyName="Chat-doka Bots"
Description="Hace que los bots escriban frases personalizadas y contextuales en el chat (una frase al azar cada 30 segundos, reaccion al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano)."

[MutNeedMoreBots]
FriendlyName="Necesitamos mas BOTS"
Description="Ajusta dinamicamente la cantidad de bots a una escala de 3 bots por cada jugador real conectado en la partida (maximo 24 bots)."

[MutSixSeven]
FriendlyName="Six Seven"
Description="En batallas por equipos (excepto Invasion), ubica siempre a todos los jugadores reales en el Equipo Azul y a todos los bots en el Equipo Rojo. Desactiva el balanceo automatico de equipos."

[MutInvasionUltimates]
FriendlyName="Invasion: Armas ultimas"
Description="Un unico punto de arma alterna al azar entre Redeemer, Target Painter, Ion Painter y Lightning Gun en cada ronda, con respawn instantaneo. Los demas puntos de esas armas quedan vacios."

[MutKayros]
FriendlyName="Poco o mucho Kayros?"
Description="En cada ronda elige a 1 jugador humano al azar y le otorga Mucho Kayros (+20% en todos los pickups) o Poco Kayros (-20% en todos los pickups)."

[MutLeTransmitoTodoAMiBB]
FriendlyName="Le transmito todo a mi BB"
Description="Desde la oleada 9, cada oleada tiene 30% de probabilidad de que aparezca un Elite Krall cuyo rayo no hace dano pero infecta (-1 HP por segundo). La infeccion se contagia por cercania y se cura apuntando 10 segundos seguidos con el disparo secundario de la Entrelazadora. Las infecciones se curan al empezar cada oleada."

[MutCuidenAFer]
FriendlyName="Cuiden a Fer!"
Description="Cada oleada de Invasion un jugador al azar (humano o bot) es Fer: no puede disparar ni levantar armas, municion o adrenalina, y todos los monstruos lo persiguen. Si Fer muere, termina la partida. Entre oleadas hay 90 segundos de descanso con +50% de velocidad. Solo compatible con Necesitamos mas BOTS, Chat-doka BOTS, Invasion: Armas ultimas y Salto cuadruple. Bloquea partidas con otros mutadores."
