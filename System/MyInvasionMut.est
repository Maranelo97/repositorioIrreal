[Public]
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutCuidenAFer,Description="[Irreal] Cuiden a Fer!||Cada oleada de Invasión un jugador al azar (humano o bot) es Fer: no puede disparar ni levantar armas, munición o adrenalina, y todos los monstruos lo persiguen. Si Fer muere, termina la partida. Entre oleadas hay 90 segundos de descanso con +50% de velocidad. Solo compatible con [Irreal] Necesitamos más BOTS, [Irreal] Chat-doka Bots, [Irreal] Invasión: Armas últimas, [Irreal] Sigan viendo y Salto cuádruple (QuadJump). Bloquea partidas con otros mutadores.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionPause,Description="[Irreal] Control de plagas FV||Pausa el inicio de la siguiente oleada en Invasión y otorga +50% de velocidad durante la pausa para recolectar ítems. El host o un admin inicia la oleada con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInstantRespawn,Description="[Irreal] Es todo muy irreal||Elimina el cooldown de los ítems del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a ítems que los jugadores dejaron caer.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutMarianoskyRage,Description="[Irreal] Marianosky's rage||25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamaño, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos daño, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y más cohetes. Al morir da doble puntaje, suelta un Double Damage, otorga +25 de escudo al equipo y revive a un compañero caído. Esos son los valores por defecto: la probabilidad, la vida, la furia y la reducción de daño se pueden cambiar en Configurar mutadores.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutChatDokaBots,Description="[Irreal] Chat-doka Bots||Hace que los bots escriban frases personalizadas y contextuales en el chat (frases al azar cada tantos segundos, reacción al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano). También silencia los mensajes de voz normales de los bots. Cada parte se puede activar o desactivar en Configurar mutadores.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutNeedMoreBots,Description="[Irreal] Necesitamos más BOTS||Ajusta dinámicamente la cantidad de bots según los jugadores reales conectados: una cantidad de bots por cada jugador (3 por defecto) con un máximo (24 por defecto). Las dos se pueden cambiar en Configurar mutadores.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionUltimates,Description="[Irreal] Invasión: Armas últimas||Un único punto de arma alterna al azar entre Redeemer, Ion Painter y Lightning Gun al terminar cada oleada (así se puede recoger durante el descanso), con respawn instantáneo. Los demás puntos de esas armas quedan vacíos. En Configurar mutadores se eligen las armas de la rotación, si cada jugador puede recogerla varias veces por oleada y si los bots pueden recogerla (por defecto no).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutSixSeven,Description="[Irreal] Six Seven||En batallas por equipos (excepto Invasión), ubica siempre a todos los jugadores reales en el Equipo Azul y a todos los bots en el Equipo Rojo. Desactiva el balanceo automático de equipos.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutKayros,Description="[Irreal] ¿Poco o mucho Kayros?||En cada ronda elige a 1 jugador humano al azar y le otorga Mucho Kayros (+20% en todos los pickups) o Poco Kayros (-20% en todos los pickups).")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutLeTransmitoTodoAMiBB,Description="[Irreal] Le transmito todo a mi BB||Desde la oleada 9, cada oleada tiene 30% de probabilidad de que aparezca un Elite Krall cuyo rayo no hace daño pero infecta (-1 HP por segundo). La infección se contagia por cercanía y se cura apuntando 10 segundos seguidos con el disparo secundario de la Entrelazadora. Las infecciones se curan al terminar cada oleada.")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutRadarMejorado,Description="[Irreal] Sigan viendo||Reemplaza los puntos del radar de Invasión por puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; el Rey Cthulhu aparece como un punto rojo más grande y Fer (en Cuiden a Fer!) en magenta. Los bots quedan con el punto tenue del radar original, para no llenar el radar. Además, cada monstruo o jugador que está en otro piso muestra una línea vertical: si está arriba, el punto queda sobre la línea; si está abajo, el punto cuelga de la línea. Cuanto más larga la línea, más diferencia de altura. Cada parte se puede desactivar en Configurar mutadores.")

[MutInvasionPause]
FriendlyName="[Irreal] Control de plagas FV"
Description="Pausa el inicio de la siguiente oleada en Invasión y otorga +50% de velocidad durante la pausa para recolectar ítems. El host o un admin inicia la oleada con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave)."

[MutInstantRespawn]
FriendlyName="[Irreal] Es todo muy irreal"
Description="Elimina el cooldown de los ítems del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a ítems que los jugadores dejaron caer."

[MutMarianoskyRage]
FriendlyName="[Irreal] Marianosky's rage"
ChancePercentText="Probabilidad por oleada (%)"
ChancePercentDesc="Probabilidad de que el Rey Cthulhu aparezca en cada oleada (de 0 a 100) [por defecto: 25]"
BaseHealthText="Vida base"
BaseHealthDesc="Vida del Rey Cthulhu antes de sumar la vida por jugador (de 100 a 20000) [por defecto: 2000]"
HealthPerPlayerText="Vida extra por jugador"
HealthPerPlayerDesc="Vida que se suma por cada jugador humano en la partida (de 0 a 5000) [por defecto: 500]"
EnragePercentText="Furia al (% de vida)"
EnragePercentDesc="Porcentaje de vida al que entra en furia: brillo rojo, +35% de velocidad y más cohetes (de 0 a 100, 0 = nunca) [por defecto: 35]"
PlayerDamageReductionText="Reducción de daño de jugadores (%)"
PlayerDamageReductionDesc="Cuánto menos daño recibe de los jugadores y del ambiente (de 0 a 95) [por defecto: 50]"
BotDamageReductionText="Reducción de daño de bots (%)"
BotDamageReductionDesc="Cuánto menos daño recibe de los bots, para que el golpe final dependa de los jugadores (de 0 a 95) [por defecto: 65]"
Description="25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamaño, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos daño, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y más cohetes. Al morir da doble puntaje, suelta un Double Damage, otorga +25 de escudo al equipo y revive a un compañero caído. Esos son los valores por defecto: la probabilidad, la vida, la furia y la reducción de daño se pueden cambiar en Configurar mutadores."

[MutChatDokaBots]
FriendlyName="[Irreal] Chat-doka Bots"
SilenceBotVoiceText="Silenciar los mensajes de voz de los bots"
SilenceBotVoiceDesc="Saca los mensajes de voz normales de los bots (por ejemplo "I've got your back"), así en el chat solo quedan las frases de Chat-doka. Los bots siguen obedeciendo órdenes, pero no responden en voz alta [por defecto: activada]"
RandomPhrasesText="Frases al azar"
RandomPhrasesDesc="Frases de la lista general: una cada tantos segundos y algunas al matar, morir, quedar con poca vida y al empezar o terminar una oleada. Si se desactiva, solo quedan las reacciones [por defecto: activada]"
DeathTauntsText="Burlas al morir un jugador"
DeathTauntsDesc="Un bot se burla por nombre del jugador que muere [por defecto: activada]"
CthulhuReactionsText="Reacciones al Rey Cthulhu"
CthulhuReactionsDesc="Un bot reacciona cuando aparece el Rey Cthulhu [por defecto: activada]"
UltimateKillReactionsText="Festejos con Redeemer e Ion Painter"
UltimateKillReactionsDesc="Un bot festeja cuando mata con el Redeemer o el Ion Painter [por defecto: activada]"
PhraseIntervalText="Segundos entre frases al azar"
PhraseIntervalDesc="Cada cuántos segundos un bot dice una frase al azar; también es el tiempo mínimo entre las frases de la lista general (de 5 a 300) [por defecto: 30]"
Description="Hace que los bots escriban frases personalizadas y contextuales en el chat (frases al azar cada tantos segundos, reacción al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano). También silencia los mensajes de voz normales de los bots. Cada parte se puede activar o desactivar en Configurar mutadores."

[MutNeedMoreBots]
FriendlyName="[Irreal] Necesitamos más BOTS"
BotsPerPlayerText="Bots por jugador"
BotsPerPlayerDesc="Cantidad de bots que se agregan por cada jugador real conectado (de 0 a 8) [por defecto: 3]"
MaxBotsText="Máximo de bots"
MaxBotsDesc="Tope de bots en la partida, sin importar cuántos jugadores haya (de 0 a 32) [por defecto: 24]"
Description="Ajusta dinámicamente la cantidad de bots según los jugadores reales conectados: una cantidad de bots por cada jugador (3 por defecto) con un máximo (24 por defecto). Las dos se pueden cambiar en Configurar mutadores."

[MutSixSeven]
FriendlyName="[Irreal] Six Seven"
Description="En batallas por equipos (excepto Invasión), ubica siempre a todos los jugadores reales en el Equipo Azul y a todos los bots en el Equipo Rojo. Desactiva el balanceo automático de equipos."

[MutInvasionUltimates]
FriendlyName="[Irreal] Invasión: Armas últimas"
RedeemerText="Redeemer"
RedeemerDesc="El Redeemer puede salir en el punto especial. Si se desactivan las tres armas, se usan todas [por defecto: activada]"
IonPainterText="Ion Painter"
IonPainterDesc="El Ion Painter puede salir en el punto especial. Si se desactivan las tres armas, se usan todas [por defecto: activada]"
LightningGunText="Lightning Gun"
LightningGunDesc="La Lightning Gun puede salir en el punto especial. Si se desactivan las tres armas, se usan todas [por defecto: activada]"
RepeatPickupText="Recogerla varias veces por oleada"
RepeatPickupDesc="Cada jugador puede volver al punto especial para recargar el arma durante la oleada. Si se desactiva, cada uno la recoge una sola vez por oleada [por defecto: activada]"
BotsCanPickupText="Los bots pueden recoger las armas últimas"
BotsCanPickupDesc="Si se desactiva, los bots no buscan el punto especial y, si pasan por encima, no recogen el arma: queda para los jugadores [por defecto: desactivada]"
Description="Un único punto de arma alterna al azar entre Redeemer, Ion Painter y Lightning Gun al terminar cada oleada (así se puede recoger durante el descanso), con respawn instantáneo. Los demás puntos de esas armas quedan vacíos. En Configurar mutadores se eligen las armas de la rotación, si cada jugador puede recogerla varias veces por oleada y si los bots pueden recogerla (por defecto no)."

[MutKayros]
FriendlyName="[Irreal] ¿Poco o mucho Kayros?"
Description="En cada ronda elige a 1 jugador humano al azar y le otorga Mucho Kayros (+20% en todos los pickups) o Poco Kayros (-20% en todos los pickups)."

[MutLeTransmitoTodoAMiBB]
FriendlyName="[Irreal] Le transmito todo a mi BB"
Description="Desde la oleada 9, cada oleada tiene 30% de probabilidad de que aparezca un Elite Krall cuyo rayo no hace daño pero infecta (-1 HP por segundo). La infección se contagia por cercanía y se cura apuntando 10 segundos seguidos con el disparo secundario de la Entrelazadora. Las infecciones se curan al terminar cada oleada."

[MutCuidenAFer]
FriendlyName="[Irreal] Cuiden a Fer!"
Description="Cada oleada de Invasión un jugador al azar (humano o bot) es Fer: no puede disparar ni levantar armas, munición o adrenalina, y todos los monstruos lo persiguen. Si Fer muere, termina la partida. Entre oleadas hay 90 segundos de descanso con +50% de velocidad. Solo compatible con [Irreal] Necesitamos más BOTS, [Irreal] Chat-doka Bots, [Irreal] Invasión: Armas últimas, [Irreal] Sigan viendo y Salto cuádruple (QuadJump). Bloquea partidas con otros mutadores."

[MutRadarMejorado]
FriendlyName="[Irreal] Sigan viendo"
ColoredDotsText="Puntos de colores"
ColoredDotsDesc="Puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; los bots quedan tenues, el Rey Cthulhu aparece en rojo y Fer en magenta. Si se desactiva, se ven los puntos normales del radar [por defecto: activada]"
ShowHeightLinesText="Líneas de altura"
ShowHeightLinesDesc="Muestra una línea vertical en cada monstruo o jugador que está en otro piso [por defecto: activada]"
MinHeightDiffText="Diferencia mínima de altura"
MinHeightDiffDesc="Diferencia de altura (en unidades, pies contra pies) a partir de la cual se dibuja la línea. Un piso suele estar a entre 200 y 500 unidades. Más bajo: más sensible (de 50 a 2000) [por defecto: 200]"
Description="Reemplaza los puntos del radar de Invasión por puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; el Rey Cthulhu aparece como un punto rojo más grande y Fer (en Cuiden a Fer!) en magenta. Los bots quedan con el punto tenue del radar original, para no llenar el radar. Además, cada monstruo o jugador que está en otro piso muestra una línea vertical: si está arriba, el punto queda sobre la línea; si está abajo, el punto cuelga de la línea. Cuanto más larga la línea, más diferencia de altura. Cada parte se puede desactivar en Configurar mutadores."
