[Public]
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionPause,Description="[Irreal] Control de plagas FV||Pausa el inicio de la siguiente oleada en Invasión y otorga +50% de velocidad durante la pausa para recolectar ítems. El host o un admin inicia la oleada con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave). La velocidad extra y la cuenta regresiva (5 segundos) se pueden cambiar en Configurar mutadores. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInstantRespawn,Description="[Irreal] Es todo muy irreal||Elimina el cooldown de los ítems del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a ítems que los jugadores dejaron caer. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutMarianoskyRage,Description="[Irreal] Marianosky's rage||25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamaño, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos daño, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y más cohetes. Al morir da doble puntaje, les llena la vida, el escudo, la munición y la adrenalina a los que están vivos, les da Double Damage hasta el final de la oleada y revive a un compañero caído. Esos son los valores por defecto: la probabilidad, la vida, la furia y la reducción de daño se pueden cambiar en Configurar mutadores. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutChatDokaBots,Description="[Irreal] Chat-doka Bots||Hace que los bots escriban frases personalizadas y contextuales en el chat (frases al azar cada tantos segundos, reacción al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano). También silencia los mensajes de voz normales de los bots. Cada parte se puede activar o desactivar en Configurar mutadores. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutNeedMoreBots,Description="[Irreal] Necesitamos más BOTS||Ajusta dinámicamente la cantidad de bots según los jugadores reales conectados: una cantidad de bots por cada jugador (3 por defecto) con un máximo (24 por defecto). En las partidas por equipos (menos Invasión) pone a todos los jugadores reales en el Equipo Azul y a todos los bots en el Rojo, sin balanceo automático. Todo se cambia en Configurar mutadores. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutInvasionUltimates,Description="[Irreal] Invasión: Armas últimas||Un único punto de arma alterna al azar entre Redeemer, Ion Painter y Lightning Gun al terminar cada oleada (así se puede recoger durante el descanso), con respawn instantáneo. Los demás puntos de esas armas quedan vacíos. En Configurar mutadores se eligen las armas de la rotación, si cada jugador puede recogerla varias veces por oleada y si los bots pueden recogerla (por defecto no). También se puede hacer que el punto cambie de lugar en cada oleada. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutKayros,Description="[Irreal] ¿Poco o mucho Kayros?||En cada oleada elige a 1 jugador humano al azar y le da Mucho Kayros (hace 30% más de daño y recibe 30% menos) o Poco Kayros (hace 30% menos de daño y recibe 30% más). Los porcentajes se cambian en Configurar mutadores. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutRadarMejorado,Description="[Irreal] Sigan viendo||Reemplaza los puntos del radar de Invasión por puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; el Rey Cthulhu aparece como un punto rojo más grande. Los bots quedan con el punto tenue del radar original, para no llenar el radar. Además, cada monstruo o jugador que está en otro piso muestra una línea vertical: si está arriba, el punto queda sobre la línea; si está abajo, el punto cuelga de la línea. Cuanto más larga la línea, más diferencia de altura. Debajo del reloj muestra la oleada actual y la final. Cada parte se puede desactivar en Configurar mutadores. (Ver 1.4.1)")
Object=(Class=Class,MetaClass=Engine.Mutator,Name=MyInvasionMut.MutGigachadrenalina,Description="[Irreal] GIGACHADrenalina||El Redeemer, el Ion Painter y la Lightning Gun usan adrenalina en vez de munición: cada disparo cuesta adrenalina (50, 25 y 5 por defecto) y al agarrar una se llena la adrenalina. Agrega dos combos: Vuelo (cuatro veces derecha; saltar sube y agacharse baja) y Visión (cuatro veces izquierda), que marca a través de las paredes a los monstruos, los jugadores, el Rey Cthulhu y los pickups útiles, con la vida de cada uno. Los combos se cortan repitiendo sus teclas y se encadenan marcando las de otro. Los combos se pueden hacer con menos de 100 de adrenalina (duran menos). Todo se cambia en Configurar mutadores. (Ver 1.4.1)")

[MutInvasionPause]
FriendlyName="[Irreal] Control de plagas FV"
SpeedBonusText="Velocidad extra en la pausa (%)"
SpeedBonusDesc="Cuánto más rápido se mueven los jugadores mientras esperan la siguiente oleada (de 0 a 200, 0 = sin velocidad extra) [por defecto: 50]"
CountdownText="Cuenta regresiva (segundos)"
CountdownDesc="Segundos que tarda en empezar la oleada después de usar 'mutate nextwave' (de 0 a 30, 0 = enseguida) [por defecto: 5]"
Description="Pausa el inicio de la siguiente oleada en Invasión y otorga +50% de velocidad durante la pausa para recolectar ítems. El host o un admin inicia la oleada con el comando 'mutate nextwave' (para usar la tecla Q, escribir en la consola: set input Q mutate nextwave). La velocidad extra y la cuenta regresiva (5 segundos) se pueden cambiar en Configurar mutadores. (Ver 1.4.1)"

[MutInstantRespawn]
FriendlyName="[Irreal] Es todo muy irreal"
Description="Elimina el cooldown de los ítems del piso (balas, salud, escudos y armas) para que se regeneren al instante. No afecta a ítems que los jugadores dejaron caer. (Ver 1.4.1)"

[MutMarianoskyRage]
FriendlyName="[Irreal] Marianosky's rage"
ChancePercentText="Probabilidad por oleada (%)"
ChancePercentDesc="Probabilidad de que el Rey Cthulhu aparezca en cada oleada (de 0 a 100) [por defecto: 25]"
BaseHealthText="Vida base"
BaseHealthDesc="Vida del Rey Cthulhu antes de sumar la vida por jugador (de 100 a 20000) [por defecto: 2000]"
HealthPerPlayerText="Vida extra por jugador"
HealthPerPlayerDesc="Vida que se suma por cada jugador humano en la partida (de 0 a 5000) [por defecto: 500]"
EnragePercentText="Furia al (% de vida)"
EnragePercentDesc="Porcentaje de vida al que entra en furia: brillo rojo, +35% de velocidad y más cohetes (de 0 a 100, 0 = nunca) [por defecto: 35]"
PlayerDamageReductionText="Reducción de daño de jugadores (%)"
PlayerDamageReductionDesc="Cuánto menos daño recibe de los jugadores y del ambiente (de 0 a 95) [por defecto: 50]"
BotDamageReductionText="Reducción de daño de bots (%)"
BotDamageReductionDesc="Cuánto menos daño recibe de los bots, para que el golpe final dependa de los jugadores (de 0 a 95) [por defecto: 65]"
Description="25% de probabilidad por oleada de que aparezca el Rey Cthulhu (WarLord con +30% de tamaño, brillo violeta, llamas en alas y pies y corona giratoria; 2000 HP base + 500 por jugador humano, 300 de escudo y +20% de velocidad; recibe 50% menos daño, o 65% menos si lo atacan bots, y 50% menos retroceso). Al 35% de vida entra en furia: brillo rojo, +35% de velocidad y más cohetes. Al morir da doble puntaje, les llena la vida, el escudo, la munición y la adrenalina a los que están vivos, les da Double Damage hasta el final de la oleada y revive a un compañero caído. Esos son los valores por defecto: la probabilidad, la vida, la furia y la reducción de daño se pueden cambiar en Configurar mutadores. (Ver 1.4.1)"

[MutChatDokaBots]
FriendlyName="[Irreal] Chat-doka Bots"
SilenceBotVoiceText="Silenciar los mensajes de voz de los bots"
SilenceBotVoiceDesc="Saca los mensajes de voz normales de los bots (por ejemplo "I've got your back"), así en el chat solo quedan las frases de Chat-doka. Los bots siguen obedeciendo órdenes, pero no responden en voz alta [por defecto: activada]"
RandomPhrasesText="Frases al azar"
RandomPhrasesDesc="Frases de la lista general: una cada tantos segundos y algunas al matar, morir, quedar con poca vida y al empezar o terminar una oleada. Si se desactiva, solo quedan las reacciones [por defecto: activada]"
DeathTauntsText="Burlas al morir un jugador"
DeathTauntsDesc="Un bot se burla por nombre del jugador que muere [por defecto: activada]"
CthulhuReactionsText="Reacciones al Rey Cthulhu"
CthulhuReactionsDesc="Un bot reacciona cuando aparece el Rey Cthulhu [por defecto: activada]"
UltimateKillReactionsText="Festejos con Redeemer e Ion Painter"
UltimateKillReactionsDesc="Un bot festeja cuando mata con el Redeemer o el Ion Painter [por defecto: activada]"
PhraseIntervalText="Segundos entre frases al azar"
PhraseIntervalDesc="Cada cuántos segundos un bot dice una frase al azar; también es el tiempo mínimo entre las frases de la lista general (de 5 a 300) [por defecto: 30]"
Description="Hace que los bots escriban frases personalizadas y contextuales en el chat (frases al azar cada tantos segundos, reacción al Rey Cthulhu, bajas con Redeemer/Ion Painter, Kayros y burlas por nombre al morir un humano). También silencia los mensajes de voz normales de los bots. Cada parte se puede activar o desactivar en Configurar mutadores. (Ver 1.4.1)"

[MutNeedMoreBots]
FriendlyName="[Irreal] Necesitamos más BOTS"
BotsPerPlayerText="Bots por jugador"
BotsPerPlayerDesc="Cantidad de bots que se agregan por cada jugador real conectado (de 0 a 8) [por defecto: 3]"
MaxBotsText="Máximo de bots"
HumansVsBotsText="Jugadores contra bots"
HumansVsBotsDesc="En las partidas por equipos (menos Invasión), todos los jugadores reales van al Equipo Azul y todos los bots al Rojo, sin balanceo automático [por defecto: activada]"
MaxBotsDesc="Tope de bots en la partida, sin importar cuántos jugadores haya (de 0 a 32) [por defecto: 24]"
Description="Ajusta dinámicamente la cantidad de bots según los jugadores reales conectados: una cantidad de bots por cada jugador (3 por defecto) con un máximo (24 por defecto). En las partidas por equipos (menos Invasión) pone a todos los jugadores reales en el Equipo Azul y a todos los bots en el Rojo, sin balanceo automático. Todo se cambia en Configurar mutadores. (Ver 1.4.1)"

[MutInvasionUltimates]
FriendlyName="[Irreal] Invasión: Armas últimas"
RedeemerText="Redeemer"
RedeemerDesc="El Redeemer puede salir en el punto especial. Si se desactivan las tres armas, se usan todas [por defecto: activada]"
IonPainterText="Ion Painter"
IonPainterDesc="El Ion Painter puede salir en el punto especial. Si se desactivan las tres armas, se usan todas [por defecto: activada]"
LightningGunText="Lightning Gun"
LightningGunDesc="La Lightning Gun puede salir en el punto especial. Si se desactivan las tres armas, se usan todas [por defecto: activada]"
RotateLocationText="El punto cambia de lugar en cada oleada"
RotateLocationDesc="Al terminar cada oleada, el arma pasa a otro punto de arma del mapa elegido al azar, y el punto anterior vuelve a tener su arma normal. Los puntos de armas pesadas del mapa quedan vacíos cuando no les toca [por defecto: desactivada]"
RepeatPickupText="Recogerla varias veces por oleada"
RepeatPickupDesc="Cada jugador puede volver al punto especial para recargar el arma durante la oleada. Si se desactiva, cada uno la recoge una sola vez por oleada [por defecto: activada]"
BotsCanPickupText="Los bots pueden recoger las armas últimas"
BotsCanPickupDesc="Si se desactiva, los bots no buscan el punto especial y, si pasan por encima, no recogen el arma: queda para los jugadores [por defecto: desactivada]"
Description="Un único punto de arma alterna al azar entre Redeemer, Ion Painter y Lightning Gun al terminar cada oleada (así se puede recoger durante el descanso), con respawn instantáneo. Los demás puntos de esas armas quedan vacíos. En Configurar mutadores se eligen las armas de la rotación, si cada jugador puede recogerla varias veces por oleada y si los bots pueden recogerla (por defecto no). También se puede hacer que el punto cambie de lugar en cada oleada. (Ver 1.4.1)"

[MutKayros]
FriendlyName="[Irreal] ¿Poco o mucho Kayros?"
DamageDealtText="Cambio del daño que hace"
DamageDealtDesc="Cuánto más daño hace el jugador con Mucho Kayros, y cuánto menos con Poco Kayros, en porcentaje (de 0 a 90) [por defecto: 30]"
DamageReceivedText="Cambio del daño que recibe"
DamageReceivedDesc="Cuánto menos daño recibe el jugador con Mucho Kayros, y cuánto más con Poco Kayros, en porcentaje (de 0 a 90) [por defecto: 30]"
Description="En cada oleada elige a 1 jugador humano al azar y le da Mucho Kayros (hace 30% más de daño y recibe 30% menos) o Poco Kayros (hace 30% menos de daño y recibe 30% más). Los porcentajes se cambian en Configurar mutadores. (Ver 1.4.1)"

[MutRadarMejorado]
FriendlyName="[Irreal] Sigan viendo"
ColoredDotsText="Puntos de colores"
ColoredDotsDesc="Puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; los bots quedan tenues y el Rey Cthulhu aparece en rojo. Si se desactiva, se ven los puntos normales del radar [por defecto: activada]"
ShowHeightLinesText="Líneas de altura"
ShowHeightLinesDesc="Muestra una línea vertical en cada monstruo o jugador que está en otro piso [por defecto: activada]"
MinHeightDiffText="Diferencia mínima de altura"
ShowWaveText="Mostrar la oleada"
ShowWaveDesc="Muestra la oleada actual y la final debajo del reloj, con el símbolo del Skaarj y los mismos números que el reloj (por ejemplo 3 / 16). En el descanso muestra la que viene [por defecto: activada]"
MinHeightDiffDesc="Diferencia de altura (en unidades, pies contra pies) a partir de la cual se dibuja la línea. Un piso suele estar a entre 200 y 500 unidades. Más bajo: más sensible (de 50 a 2000) [por defecto: 200]"
Description="Reemplaza los puntos del radar de Invasión por puntos fijos, sin parpadeo: amarillo para monstruos y verde para jugadores; el Rey Cthulhu aparece como un punto rojo más grande. Los bots quedan con el punto tenue del radar original, para no llenar el radar. Además, cada monstruo o jugador que está en otro piso muestra una línea vertical: si está arriba, el punto queda sobre la línea; si está abajo, el punto cuelga de la línea. Cuanto más larga la línea, más diferencia de altura. Debajo del reloj muestra la oleada actual y la final. Cada parte se puede desactivar en Configurar mutadores. (Ver 1.4.1)"

[MutGigachadrenalina]
FriendlyName="[Irreal] GIGACHADrenalina"
AdrenalineUltimatesText="Armas últimas con adrenalina"
AdrenalineUltimatesDesc="El Redeemer, el Ion Painter y la Lightning Gun gastan adrenalina en vez de munición. Si se desactiva, usan munición normal y solo quedan los combos [por defecto: activada]"
RedeemerCostText="Adrenalina por disparo: Redeemer"
RedeemerCostDesc="Adrenalina que cuesta cada disparo del Redeemer (de 0 a 100, 0 = gratis) [por defecto: 50]"
IonPainterCostText="Adrenalina por disparo: Ion Painter"
IonPainterCostDesc="Adrenalina que cuesta cada disparo del Ion Painter (de 0 a 100, 0 = gratis) [por defecto: 25]"
LightningGunCostText="Adrenalina por disparo: Lightning Gun"
LightningGunCostDesc="Adrenalina que cuesta cada disparo de la Lightning Gun (de 0 a 100, 0 = gratis) [por defecto: 5]"
FillAdrenalineOnPickupText="Llenar la adrenalina al agarrar un arma última"
FlightComboText="Combo Vuelo"
FlightComboDesc="Cuatro veces derecha: volás libremente durante 20 segundos (con el gasto normal); saltar sube y agacharse baja [por defecto: activada]"
VisionComboText="Combo Visión"
VisionComboDesc="Cuatro veces izquierda: durante 30 segundos (con el gasto normal) quedan marcados a través de las paredes los monstruos (amarillo), los otros jugadores (verde), el Rey Cthulhu (rojo) y los pickups importantes que podés agarrar (blanco). Los marcos se llenan según la vida que les queda; el de los jugadores muestra la vida a la izquierda y el escudo a la derecha [por defecto: activada]"
CancelCombosText="Cortar el combo repitiendo las teclas"
CancelCombosDesc="Si repetís las teclas del combo que tenés activo, se corta y te queda la adrenalina que sobraba. Vale para todos los combos [por defecto: activada]"
ComboDrainPercentText="Gasto de adrenalina de los combos (%)"
ComboDrainPercentDesc="Qué tan rápido gastan adrenalina los combos: con 50 duran el doble y con 200 la mitad. Vale para todos los combos (de 0 a 400, 0 = no gastan) [por defecto: 100]"
AdrenalinePillAmountText="Adrenalina por pastilla"
AdrenalinePillAmountDesc="Adrenalina que da cada pastilla de adrenalina del mapa (de 1 a 100) [por defecto: 2]"
LowAdrenalineCombosText="Combos con menos de 100 de adrenalina"
LowAdrenalineCombosDesc="Se puede hacer un combo con la adrenalina que tengas, aunque no llegue a 100: dura menos, en proporción (con 50, la mitad). Además, con un combo activo, si marcás las teclas de otro combo cambiás a ese, con la adrenalina que te quedaba. Vale para todos los combos [por defecto: activada]"
InfiniteAdrenalineText="Adrenalina infinita"
InfiniteAdrenalineDesc="La adrenalina de los jugadores (no la de los bots) siempre está llena: los combos no se terminan solos y, con las armas últimas con adrenalina, disparar no gasta [por defecto: desactivada]"
FillAdrenalineOnPickupDesc="Al agarrar un arma última que no tenías, la adrenalina se llena. Volver a tocar el punto mientras la tenés no da nada. Solo funciona con las armas últimas con adrenalina [por defecto: activada]"
Description="El Redeemer, el Ion Painter y la Lightning Gun usan adrenalina en vez de munición: cada disparo cuesta adrenalina (50, 25 y 5 por defecto) y al agarrar una se llena la adrenalina. Agrega dos combos: Vuelo (cuatro veces derecha; saltar sube y agacharse baja) y Visión (cuatro veces izquierda), que marca a través de las paredes a los monstruos, los jugadores, el Rey Cthulhu y los pickups útiles, con la vida de cada uno. Los combos se cortan repitiendo sus teclas y se encadenan marcando las de otro. Los combos se pueden hacer con menos de 100 de adrenalina (duran menos). Todo se cambia en Configurar mutadores. (Ver 1.4.1)"

[ComboVuelo]
ExecMessage="¡Vuelo!"

[ComboVision]
ExecMessage="¡Visión!"
